{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.distracted.dev/iam/oauth/token-response.schema.json",
  "title": "DPoP Access Token Response v1",
  "type": "object", "additionalProperties": false,
  "required": ["access_token", "token_type", "expires_in", "scope"],
  "properties": {
    "access_token": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$", "maxLength": 8192},
    "token_type": {"const": "DPoP"},
    "expires_in": {"type": "integer", "minimum": 1, "maximum": 900},
    "scope": {"type": "string", "pattern": "^[a-z][a-z0-9:_-]{0,63}( [a-z][a-z0-9:_-]{0,63}){0,31}$"}
  }
}
