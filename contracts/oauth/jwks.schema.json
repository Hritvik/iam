{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.distracted.dev/iam/oauth/jwks.schema.json",
  "title": "IAM Public JSON Web Key Set v1",
  "type": "object", "additionalProperties": false, "required": ["keys"],
  "properties": {
    "keys": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kty", "use", "alg", "kid", "crv", "x", "y"],
        "properties": {
          "kty": {"const": "EC"}, "use": {"const": "sig"}, "alg": {"const": "ES256"},
          "kid": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$"}, "crv": {"const": "P-256"},
          "x": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}, "y": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
        }
      }
    }
  }
}
