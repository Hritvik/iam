{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.distracted.dev/iam/oauth/protected-resource-metadata.schema.json",
  "title": "Protected Resource Metadata v1",
  "type": "object", "additionalProperties": false,
  "required": ["resource", "authorization_servers", "scopes_supported", "bearer_methods_supported", "resource_signing_alg_values_supported"],
  "properties": {
    "resource": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 256},
    "authorization_servers": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 256}},
    "scopes_supported": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9:_-]{0,63}$"}},
    "bearer_methods_supported": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"const": "header"}], "items": false},
    "resource_signing_alg_values_supported": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"const": "ES256"}], "items": false}
  }
}
