{
  "manifestVersion": 1,
  "appRegistrationId": "dutch-development",
  "displayName": "Dutch Development",
  "environment": "development",
  "client": {
    "clientId": "dutch-mobile",
    "clientType": "NATIVE_PUBLIC",
    "redirectUris": ["dutch://oauth/callback"],
    "grantTypes": ["authorization_code"],
    "pkceMethods": ["S256"],
    "browserMode": "EXTERNAL"
  },
  "resource": {
    "resourceId": "dutch-api",
    "audience": "https://api.dutch.invalid",
    "allowedScopes": ["member:read"]
  },
  "securityPolicy": {
    "policyVersion": 1,
    "requireDpop": true,
    "requiredPkceMethod": "S256",
    "allowedGrantTypes": ["authorization_code"],
    "requiredActivationEvidence": ["verified_identifier", "usable_factor", "recovery_path"]
  }
}
