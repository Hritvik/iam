{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.distracted.dev/iam/manifest/app-registration.schema.json",
  "title": "First-party App Registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "appRegistrationId", "displayName", "environment", "client", "resource", "securityPolicy"],
  "properties": {
    "manifestVersion": {"const": 1},
    "appRegistrationId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 80},
    "environment": {"enum": ["development", "test", "staging", "production"]},
    "client": {
      "type": "object", "additionalProperties": false,
      "required": ["clientId", "clientType", "redirectUris", "grantTypes", "pkceMethods", "browserMode"],
      "properties": {
        "clientId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "clientType": {"const": "NATIVE_PUBLIC"},
        "redirectUris": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "format": "uri", "minLength": 8, "maxLength": 512, "oneOf": [
          {"pattern": "^https://[^*#\\s]+$"},
          {"pattern": "^http://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\])(?::[0-9]{1,5})?/[^*#\\s]*$"},
          {"pattern": "^(?!(?:https?|javascript|data|file):)[a-z][a-z0-9+.-]*://[^*#\\s]+$"}
        ]}},
        "grantTypes": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"const": "authorization_code"}], "items": false},
        "pkceMethods": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"const": "S256"}], "items": false},
        "browserMode": {"const": "EXTERNAL"}
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["resourceId", "audience", "allowedScopes"],
      "properties": {
        "resourceId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "audience": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 256},
        "allowedScopes": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9:_-]{0,63}$"}}
      }
    },
    "securityPolicy": {"$ref": "product-security-policy.schema.json"}
  }
}
