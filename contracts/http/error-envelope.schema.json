{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.distracted.dev/iam/http/error-envelope.schema.json",
  "title": "Standard Error Envelope v1",
  "type": "object", "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "correlationId"],
      "properties": {
        "code": {"enum": ["invalid_request", "unauthorized", "forbidden", "not_found", "rate_limited", "internal_error", "service_unavailable"]},
        "message": {"enum": ["Request is invalid", "Authentication is required", "Access is denied", "Resource was not found", "Request rate limit exceeded", "Request could not be completed", "Service is temporarily unavailable"]},
        "correlationId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "details": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["field", "code"], "properties": {"field": {"enum": ["appRegistrationId", "cursor", "limit"]}, "code": {"enum": ["missing", "malformed", "out_of_range"]}}}}
      },
      "allOf": [{"oneOf": [
        {"properties": {"code": {"const": "invalid_request"}, "message": {"const": "Request is invalid"}}},
        {"properties": {"code": {"const": "unauthorized"}, "message": {"const": "Authentication is required"}}},
        {"properties": {"code": {"const": "forbidden"}, "message": {"const": "Access is denied"}}},
        {"properties": {"code": {"const": "not_found"}, "message": {"const": "Resource was not found"}}},
        {"properties": {"code": {"const": "rate_limited"}, "message": {"const": "Request rate limit exceeded"}}},
        {"properties": {"code": {"const": "internal_error"}, "message": {"const": "Request could not be completed"}}},
        {"properties": {"code": {"const": "service_unavailable"}, "message": {"const": "Service is temporarily unavailable"}}}
      ]}]
    }
  }
}
