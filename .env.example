# Template only. Run deploy/generate-local-secrets.sh to produce a real .env, or copy this file and
# replace every example-only value. .env is git-ignored.
POSTGRES_USER=postgres
POSTGRES_DB=iam
POSTGRES_PASSWORD=example-only-postgres

IAM_MIGRATOR_PASSWORD=example-only-migrator
IAM_RUNTIME_PASSWORD=example-only-runtime
IAM_RELAY_PASSWORD=example-only-relay
IAM_REGISTRATION_RECONCILER_PASSWORD=example-only-reconciler

IAM_DB_URL=jdbc:postgresql://postgres:5432/iam
IAM_DB_USERNAME=iam_runtime
IAM_DB_PASSWORD=example-only-runtime

IAM_FLYWAY_URL=jdbc:postgresql://postgres:5432/iam
IAM_FLYWAY_USERNAME=iam_migrator
IAM_FLYWAY_PASSWORD=example-only-migrator

IAM_RECONCILER_URL=jdbc:postgresql://postgres:5432/iam
IAM_RECONCILER_USERNAME=iam_registration_reconciler
IAM_RECONCILER_PASSWORD=example-only-reconciler

IAM_ISSUER=https://iam.localhost
IAM_REGISTRATION_ENABLED=true
IAM_FIXTURES_ENABLED=false

IAM_CRYPTO_LOCAL_ENABLED=true
IAM_CRYPTO_LOCAL_PROVIDER=local-jca
IAM_CRYPTO_LOCAL_SIGNER_KEY_ID=local-signing-v1
IAM_CRYPTO_LOCAL_SIGNER_PRIVATE_KEY=example-only-base64-pkcs8
IAM_CRYPTO_LOCAL_ENCRYPTION_KEY_REFERENCE=local-encryption-v1
IAM_CRYPTO_LOCAL_ENCRYPTION_KEY=example-only-base64-key
IAM_CRYPTO_LOCAL_BLIND_INDEX_KEY_REFERENCE=local-blind-index-v1
IAM_CRYPTO_LOCAL_BLIND_INDEX_KEY=example-only-base64-key
IAM_CRYPTO_LOCAL_CHALLENGE_DIGEST_KEY_REFERENCE=local-challenge-digest-v1
IAM_CRYPTO_LOCAL_CHALLENGE_DIGEST_KEY=example-only-base64-key
